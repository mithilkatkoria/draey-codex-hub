{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draey Codex Hub",
  "version": "0.1.0",
  "identifier": "dev.draey.codexhub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Draey Codex Hub",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#0d0e14",
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Every Codex profile. One command centre.",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
